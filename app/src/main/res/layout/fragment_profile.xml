<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.profile.ProfileFragment">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ✅ Bagian Foto & Nama Profil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="4dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="4dp"
                    app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="true">

                    <ImageView
                        android:id="@+id/img_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/baseline_person_24"
                        android:contentDescription="Foto Profil" />
                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Pengguna"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/txt_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="email@contoh.com"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                    <TextView
                        android:id="@+id/txt_profile_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mencari lokasi..."
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>

            <!-- Menu Items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="?android:attr/dividerVertical"
                android:showDividers="middle"
                android:background="@android:color/white"
                android:paddingVertical="8dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/item_edit_profile"
                    style="@style/AccountMenuItem"
                    android:drawableStart="@drawable/spinner"
                    android:text="Edit Profile"
                    android:drawablePadding="8dp" />

                <!-- My Orders -->
                <TextView
                    android:id="@+id/item_my_orders"
                    style="@style/AccountMenuItem"
                    android:drawableStart="@drawable/ic_orders"
                    android:text="My Orders"
                    android:drawablePadding="8dp" />

                <!-- Shipping Address -->
                <TextView
                    android:id="@+id/item_change_p"
                    style="@style/AccountMenuItem"
                    android:drawableStart="@drawable/change_p"
                    android:text="Change Password"
                    android:drawablePadding="8dp" />

                <!-- Help Center -->
                <TextView
                    android:id="@+id/item_help_center"
                    style="@style/AccountMenuItem"
                    android:drawableStart="@drawable/ic_help"
                    android:text="Kontak Kami"
                    android:drawablePadding="8dp" />

                <!-- Logout -->
                <TextView
                    android:id="@+id/item_logout"
                    style="@style/AccountMenuItem"
                    android:drawableStart="@drawable/back"
                    android:text="Logout"
                    android:drawablePadding="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
